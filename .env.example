# Django settings.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Enable only when deployed behind Render's trusted HTTPS proxy.
DJANGO_TRUST_PROXY=0
# Public hosting uses an Auditor account and verified, precomputed fixtures.
LEDGERSYNC_PUBLIC_DEMO=0

# PostgreSQL is used by Docker Compose. Leave DATABASE_URL empty to use
# SQLite for a very quick backend-only local experiment.
DATABASE_URL=postgresql://ledger_sync:ledger_sync_password@db:5432/ledger_sync

# Redis is used by Django caching and Celery.
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0

# File upload limit in bytes. This example allows files up to 100 MB.
MAX_UPLOAD_SIZE=104857600

# Next.js browser configuration.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO=0
